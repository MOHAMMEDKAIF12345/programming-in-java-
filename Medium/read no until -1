import java.util.Scanner;
public class AverageCalculator {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        double sumPositive = 0, sumNegative = 0;
        int countPositive = 0, countNegative = 0;
        
        System.out.println("Enter numbers (-1 to exit):");
        
        while (true) {
            int number = scanner.nextInt();
            if (number == -1) break;

            if (number > 0) {
                sumPositive += number;
                countPositive++;
            } else {
                sumNegative += number;
                countNegative++;
            }
        }
        double averagePositive = countPositive > 0 ? sumPositive / countPositive : 0;
        double averageNegative = countNegative > 0 ? sumNegative / countNegative : 0;
        System.out.printf("The average of negative numbers is: %.1f%n", averageNegative);
        System.out.printf("The average of positive numbers is: %.8f%n", averagePositive);
        scanner.close();
    }
}
