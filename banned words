import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;
public class MostFrequentWord {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the paragraph: ");
        String paragraph = scanner.nextLine();
        System.out.print("Enter banned words (comma separated): ");
        String[] banned = scanner.nextLine().toLowerCase().split(",\\s*");
        Map<String, Integer> wordCount = new HashMap<>();
        for (String word : paragraph.toLowerCase().replaceAll("[^a-z ]", "").split("\\s+")) {
            if (!isBanned(word, banned)) {
                wordCount.put(word, wordCount.getOrDefault(word, 0) + 1);
            }
        }
        System.out.println("Most frequent non-banned word: " + wordCount.entrySet().stream()
                .max(Map.Entry.comparingByValue()).get().getKey());
        
        scanner.close();
    }
    private static boolean isBanned(String word, String[] banned) {
        for (String ban : banned) if (ban.equals(word)) return true;
        return false;
    }
}
